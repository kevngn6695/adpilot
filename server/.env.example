# Copy to .env and fill in. .env is git-ignored — never commit real passwords or keys.

NODE_ENV=development
# 5050, not 5000: macOS uses port 5000 for AirPlay.
PORT=5050

# Full Postgres connection string.
DATABASE_URL=postgres://adpilot:adpilot@localhost:5432/adpilot

# TLS to the database: auto (on in production unless the DB is local) | true | false
DB_SSL=auto

# Origin of the web app in production (for CORS). Localhost dev ports are always allowed.
FRONTEND_URL=

# Optional. Without a key, ad copy is generated from built-in templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Business time zone: reports cut over at local midnight.
APP_TIMEZONE=America/Los_Angeles

# pino levels: silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info
